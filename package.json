{
  "name": "cruise-antigravity-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "The BytesBrains Cruise plugin for Google Antigravity (IDE & agy CLI) — skills, rules, and MCP budget tools.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bytesbrains/cruise-antigravity-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets:scan": "gitleaks detect --source . --redact --no-banner --config .gitleaks.toml"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  }
}
