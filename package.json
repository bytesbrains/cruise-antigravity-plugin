{
  "name": "cruise-antigravity-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The BytesBrains Cruise plugin for Google Antigravity (IDE & agy CLI) — skills, rules, and MCP budget tools.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bytesbrains/cruise-antigravity-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "tsx ./plugins/cruise/skills/setup/scripts/setup.ts",
    "setup:ide": "tsx ./plugins/cruise/skills/setup/scripts/ide-config.ts",
    "lanes": "tsx ./plugins/cruise/skills/lane/scripts/lane.ts",
    "secrets:scan": "gitleaks detect --source . --redact --no-banner --config .gitleaks.toml"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.1"
  }
}
